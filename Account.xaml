<Window x:Class="Avtorizatzia.Account"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Avtorizatzia"
        mc:Ignorable="d"
        Title="Личный кабинет" 
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#E8F0FE" Closing="Close_Click">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtWelcome"
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,0" Foreground="#1565C0"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="120,0,0,0">
            <Button x:Name="btnChangePassword" Content="Сменить пароль" 
                    Width="200" Height="40" 
                    Margin="0,10" FontSize="16"
                    Click="BtnChangePassword_Click"/>

            <Button x:Name="btnLogout" Content="Выйти из аккаунта" 
                    Width="200" Height="40" 
                    Margin="0,10" FontSize="16"
                    Background="#AAAAAA" 
                    Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</Window>
